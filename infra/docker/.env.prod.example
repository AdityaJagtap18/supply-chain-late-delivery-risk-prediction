# Production environment — copy to infra/docker/.env.prod on the VPS and fill in real values.
# Never commit infra/docker/.env.prod (it holds real secrets).

# --- Subdomains (must already point at the VPS's IP via DNS A records — see docs/DEPLOYMENT.md)
APP_DOMAIN=shipguard.adityajagtap.com
API_DOMAIN=shipguard-api.adityajagtap.com

# --- PostgreSQL ---
POSTGRES_DB=supplychain_prod
POSTGRES_USER=supplychain_prod
POSTGRES_PASSWORD=change_this_to_a_long_random_value

# --- Backend ---
SPRING_PROFILES_ACTIVE=prod
SESSION_SECRET=change_this_to_a_long_random_value
BATCH_SCORING_CADENCE_CRON=TBD

# --- ML inference service ---
ML_SERVICE_PORT=8001
MODEL_ARTIFACT_PATH=./artifacts/model.joblib
ENCODER_ARTIFACT_PATH=./artifacts/encoders.json

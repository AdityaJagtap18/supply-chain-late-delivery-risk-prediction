# Environment variable inventory — local development only.
# Prepared by IMPL-001. No real secrets. No production values are implied by anything below;
# where a value depends on a decision not yet made (cloud provider, batch cadence), it is marked
# TBD rather than filled in with an invented default that could be mistaken for a decision.

# --- PostgreSQL (ADR-0003, Accepted) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=supplychain_dev
POSTGRES_USER=supplychain_dev
POSTGRES_PASSWORD=changeme_local_only

# --- Backend (Java Spring Boot + Spring Security, ADR-0002/ADR-0005, Accepted) ---
SPRING_PROFILES_ACTIVE=local
# Session secret for Spring Security's session cookie signing — local dev value only, never
# reused in any shared environment.
SESSION_SECRET=changeme_local_only
# Where the backend reaches the separate ML inference service (ADR-0004, Accepted).
ML_SERVICE_URL=http://localhost:8001
# FR-031's batch-scoring cadence is explicitly undecided (ARCH-CONSISTENCY-001 CONS-005) — do
# not fill this in with an assumed production value. Scheduler-based execution is the documented
# baseline; the actual interval is a configuration decision for whoever owns DEV-STRATEGY-001.
BATCH_SCORING_CADENCE_CRON=TBD

# --- ML inference service (separate Python service, ADR-0004, Accepted) ---
ML_SERVICE_PORT=8001
# File-based model/encoder artifact locations (ADR-0007, Accepted — file-based for MVP).
MODEL_ARTIFACT_PATH=./artifacts/model.joblib
ENCODER_ARTIFACT_PATH=./artifacts/encoders.json

# --- Frontend (Angular, ADR-0001, Accepted) ---
API_BASE_URL=http://localhost:8080

# --- Deployment (ADR-0006, Accepted — containerized app components; serverless evaluated for
# the batch job alone) ---
# No cloud provider or orchestrator is selected by ADR-0006. Do not add a provider-specific
# variable here until that decision is made.
